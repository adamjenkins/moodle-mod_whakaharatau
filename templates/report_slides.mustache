{{!
    @template mod_whakaharatau/report_slides

    The teacher report's per-slide view: how often each slide was answered right on the first try.

    Context variables required for this template:
    * cansee - false when the viewer may see no learner (separate groups, not in a group)
    * istest - true for Test attempts, false for Practice sessions
    * hasrows - whether the activity has slides
    * rows - list of: number, alttext, decorative, imageurl, appearances, firsttry, percent (text),
      percentvalue (0-100), hasdata, choices

    Example context (json):
    {
        "cansee": true,
        "istest": false,
        "hasrows": true,
        "rows": [
            {
                "number": "1", "alttext": "A dog running on a beach", "decorative": false,
                "imageurl": "https://example.com/pluginfile.php/5/mod_whakaharatau/slideimage/3/1700000000/image.jpg",
                "appearances": "24", "firsttry": "18", "percent": "75%", "percentvalue": 75, "hasdata": true,
                "choices": "31"
            }
        ]
    }
}}
<div class="mod-whakaharatau-report-slides">
    {{^cansee}}
    <p class="alert alert-info">{{#str}} report_notingroup, mod_whakaharatau {{/str}}</p>
    {{/cansee}}
    {{#cansee}}
    {{^hasrows}}
    <p class="alert alert-info">{{#str}} report_noslides, mod_whakaharatau {{/str}}</p>
    {{/hasrows}}
    {{#hasrows}}
    <div class="table-responsive">
        <table class="table table-striped generaltable">
            <caption class="visually-hidden">{{#str}} report_slidescaption, mod_whakaharatau {{/str}}</caption>
            <thead>
                <tr>
                    <th scope="col">{{#str}} report_slide, mod_whakaharatau {{/str}}</th>
                    <th scope="col">{{#str}} report_image, mod_whakaharatau {{/str}}</th>
                    <th scope="col">{{#str}} report_appearances, mod_whakaharatau {{/str}}</th>
                    <th scope="col">{{#str}} report_firsttry, mod_whakaharatau {{/str}}</th>
                    <th scope="col">{{#str}} report_percentfirsttry, mod_whakaharatau {{/str}}</th>
                    <th scope="col">{{#str}} report_choices, mod_whakaharatau {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#rows}}
                <tr>
                    <th scope="row">{{number}}</th>
                    <td>
                        {{! The alt text is printed next to the thumbnail, so the image itself is not announced again. }}
                        {{#imageurl}}<img src="{{imageurl}}" alt="" class="img-thumbnail mod-whakaharatau-report-thumb" loading="lazy">{{/imageurl}}
                        <span class="d-block small{{#decorative}} text-muted{{/decorative}}">{{alttext}}</span>
                    </td>
                    <td>{{appearances}}</td>
                    <td>{{firsttry}}</td>
                    <td>
                        {{#hasdata}}
                        <span>{{percent}}</span>
                        <div class="progress mt-1 mod-whakaharatau-report-progress" aria-hidden="true">
                            <div class="progress-bar" style="width: {{percentvalue}}%;"></div>
                        </div>
                        {{/hasdata}}
                    </td>
                    <td>{{choices}}</td>
                </tr>
                {{/rows}}
            </tbody>
        </table>
    </div>
    {{/hasrows}}
    {{/cansee}}
</div>
