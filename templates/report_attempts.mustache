{{!
    @template mod_whakaharatau/report_attempts

    The teacher report's attempts view: one row per Test attempt or Practice session, with checkboxes to
    delete attempts when the viewer may.

    Context variables required for this template:
    * cmid - course module id
    * cansee - false when the viewer may see no learner (separate groups, not in a group)
    * istest - true for Test attempts, false for Practice sessions
    * hasrows - whether there are rows
    * candelete - whether the delete checkboxes and button are shown
    * formaction, sesskey, mode, attemptmode - for the delete form
    * rows - list of: attemptid, fullname, profileurl, firstofuser, attempt, state, timestart, and either
      (Test) timefinish, score, percent, grade or (Practice) timemodified, rounds, slidesanswered, firsttry,
      firsttryrate, beststreak

    Example context (json):
    {
        "cmid": 5,
        "cansee": true,
        "istest": true,
        "hasrows": true,
        "candelete": true,
        "formaction": "https://example.com/mod/whakaharatau/report.php",
        "sesskey": "abc123",
        "mode": "attempts",
        "attemptmode": 1,
        "rows": [
            {
                "attemptid": 12, "fullname": "Aroha Ngata", "profileurl": "https://example.com/user/view.php?id=3",
                "firstofuser": true, "attempt": "1", "state": "Finished", "timestart": "17/11/26, 10:02",
                "timefinish": "17/11/26, 10:09", "score": "16 / 20", "percent": "80%", "grade": "80 / 100"
            }
        ]
    }
}}
<div class="mod-whakaharatau-report-attempts">
    {{^cansee}}
    <p class="alert alert-info">{{#str}} report_notingroup, mod_whakaharatau {{/str}}</p>
    {{/cansee}}
    {{#cansee}}
    {{^hasrows}}
    <p class="alert alert-info">{{#str}} report_noattempts, mod_whakaharatau {{/str}}</p>
    {{/hasrows}}
    {{#hasrows}}
    <form method="post" action="{{formaction}}" id="mod-whakaharatau-report-form-{{cmid}}">
        <input type="hidden" name="id" value="{{cmid}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="mode" value="{{mode}}">
        <input type="hidden" name="attemptmode" value="{{attemptmode}}">
        <input type="hidden" name="action" value="delete">
        <div class="table-responsive">
            <table class="table table-striped generaltable">
                <caption class="visually-hidden">{{#istest}}{{#str}} report_modetest, mod_whakaharatau {{/str}}{{/istest}}{{^istest}}{{#str}} report_modepractice, mod_whakaharatau {{/str}}{{/istest}}</caption>
                <thead>
                    <tr>
                        {{#candelete}}<th scope="col"><span class="visually-hidden">{{#str}} report_select, mod_whakaharatau {{/str}}</span></th>{{/candelete}}
                        <th scope="col">{{#str}} report_learner, mod_whakaharatau {{/str}}</th>
                        {{#istest}}
                        <th scope="col">{{#str}} report_attempt, mod_whakaharatau {{/str}}</th>
                        <th scope="col">{{#str}} report_state, mod_whakaharatau {{/str}}</th>
                        <th scope="col">{{#str}} report_started, mod_whakaharatau {{/str}}</th>
                        <th scope="col">{{#str}} report_timefinish, mod_whakaharatau {{/str}}</th>
                        <th scope="col">{{#str}} report_score, mod_whakaharatau {{/str}}</th>
                        <th scope="col">{{#str}} report_percent, mod_whakaharatau {{/str}}</th>
                        <th scope="col">{{#str}} report_grade, mod_whakaharatau {{/str}}</th>
                        {{/istest}}
                        {{^istest}}
                        <th scope="col">{{#str}} report_session, mod_whakaharatau {{/str}}</th>
                        <th scope="col">{{#str}} report_state, mod_whakaharatau {{/str}}</th>
                        <th scope="col">{{#str}} report_started, mod_whakaharatau {{/str}}</th>
                        <th scope="col">{{#str}} report_lastactivity, mod_whakaharatau {{/str}}</th>
                        <th scope="col">{{#str}} report_rounds, mod_whakaharatau {{/str}}</th>
                        <th scope="col">{{#str}} report_slidesanswered, mod_whakaharatau {{/str}}</th>
                        <th scope="col">{{#str}} report_firsttry, mod_whakaharatau {{/str}}</th>
                        <th scope="col">{{#str}} report_firsttryrate, mod_whakaharatau {{/str}}</th>
                        <th scope="col">{{#str}} report_beststreak, mod_whakaharatau {{/str}}</th>
                        {{/istest}}
                    </tr>
                </thead>
                <tbody>
                    {{#rows}}
                    <tr>
                        {{#candelete}}
                        <td>
                            <input type="checkbox" class="form-check-input" name="attemptid[]" value="{{attemptid}}"
                                id="mod-whakaharatau-attempt-{{attemptid}}">
                            <label class="visually-hidden" for="mod-whakaharatau-attempt-{{attemptid}}">{{#str}} report_selectattempt, mod_whakaharatau, { "name": {{#quote}}{{fullname}}{{/quote}}, "attempt": {{#quote}}{{attempt}}{{/quote}} } {{/str}}</label>
                        </td>
                        {{/candelete}}
                        {{! The th carries the name on each row, so screen readers announce whose attempt a cell is. }}
                        <th scope="row">{{#firstofuser}}<a href="{{profileurl}}">{{fullname}}</a>{{/firstofuser}}{{^firstofuser}}<span class="visually-hidden">{{fullname}}</span>{{/firstofuser}}</th>
                        <td>{{attempt}}</td>
                        <td>{{state}}</td>
                        <td>{{timestart}}</td>
                        {{#istest}}
                        <td>{{timefinish}}</td>
                        <td>{{score}}</td>
                        <td>{{percent}}</td>
                        <td>{{grade}}</td>
                        {{/istest}}
                        {{^istest}}
                        <td>{{timemodified}}</td>
                        <td>{{rounds}}</td>
                        <td>{{slidesanswered}}</td>
                        <td>{{firsttry}}</td>
                        <td>{{firsttryrate}}</td>
                        <td>{{beststreak}}</td>
                        {{/istest}}
                    </tr>
                    {{/rows}}
                </tbody>
            </table>
        </div>
        {{#candelete}}
        <button type="submit" class="btn btn-danger">{{#str}} deleteselected, mod_whakaharatau {{/str}}</button>
        {{/candelete}}
    </form>
    {{/hasrows}}
    {{/cansee}}
</div>
