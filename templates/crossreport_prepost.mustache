{{!
    @template mod_whakaharatau/crossreport_prepost

    Choosing the two activities to compare, and the result in words.

    Context variables required for this template:
    * formaction, hidden - the form
    * preoptions, postoptions - lists of value, label and selected
    * hassummary, summary - the result

    Example context (json):
    {
        "formaction": "https://example.com/mod/whakaharatau/crossreport.php",
        "hidden": [{"name": "view", "value": "prepost"}],
        "preoptions": [{"value": 1, "label": "Before (Course 1)", "selected": true}],
        "postoptions": [{"value": 2, "label": "After (Course 1)", "selected": true}],
        "hassummary": true,
        "summary": "12 learners finished both."
    }
}}
<form method="get" action="{{formaction}}" class="d-flex flex-wrap align-items-end gap-3 mb-3">
    {{#hidden}}<input type="hidden" name="{{name}}" value="{{value}}">{{/hidden}}
    <div>
        <label for="mod-whakaharatau-pre">{{#str}} crossreport_pre, mod_whakaharatau {{/str}}</label>
        <select name="pre" id="mod-whakaharatau-pre" class="form-select">
            <option value="0">{{#str}} choosedots {{/str}}</option>
            {{#preoptions}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/preoptions}}
        </select>
    </div>
    <div>
        <label for="mod-whakaharatau-post">{{#str}} crossreport_post, mod_whakaharatau {{/str}}</label>
        <select name="post" id="mod-whakaharatau-post" class="form-select">
            <option value="0">{{#str}} choosedots {{/str}}</option>
            {{#postoptions}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/postoptions}}
        </select>
    </div>
    <button type="submit" class="btn btn-primary">{{#str}} crossreport_compare, mod_whakaharatau {{/str}}</button>
</form>
{{#hassummary}}<p class="lead">{{summary}}</p>{{/hassummary}}
